PORT=4000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/ai_resume
JWT_SECRET=replace_with_a_long_random_secret
DEV_ALLOW_ANONYMOUS=true

# Primary AI Provider (Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Fallback AI Provider (Grok / xAI) - Optional
# The server will start and work with Gemini even if XAI_API_KEY is not set.
XAI_API_KEY=your_xai_api_key_here
XAI_MODEL=grok-2-latest
XAI_BASE_URL=https://api.x.ai/v1

# Adzuna Job Search (Optional)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
